# Copia in .env (non committare .env)
PORT=3000
HOST=127.0.0.1

# Database SQLite (driver libSQL). Il percorso è relativo a packages/server.
DATABASE_URL=file:./data/lanterna.db

# Segreto di Better Auth, almeno 32 caratteri. OBBLIGATORIO in produzione (il server non parte senza).
# Generalo con: openssl rand -base64 32
BETTER_AUTH_SECRET=
# URL pubblico del server, es. https://lanterna.example.com. OBBLIGATORIO in produzione.
BETTER_AUTH_URL=http://localhost:3000
# Altre origini ammesse per POST/PATCH/DELETE, separate da virgola.
# In sviluppo, se non impostato, vale http://localhost:5173 (client Vite).
TRUSTED_ORIGINS=http://localhost:5173

# Proxy fidato da cui leggere X-Forwarded-For/Proto: false, true, oppure IP/subnet separati da virgola.
# Con Cloudflare Tunnel (cloudflared sulla stessa macchina): loopback
TRUST_PROXY=false

# Rate limit per IP, tentativi al minuto.
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_CREATE_USER_MAX=10

# Facoltativi per `npm run create-admin -w @lanterna/server` (altrimenti li chiede al prompt).
# LANTERNA_ADMIN_EMAIL=
# LANTERNA_ADMIN_NAME=
# LANTERNA_ADMIN_PASSWORD=

# NODE_ENV=production

# File caricati (mappe e immagini dei token). Relativo alla cartella da cui parte il server
# (packages/server con npm run dev/start). Fuori dalla webroot; mai nel repo (già in .gitignore).
UPLOAD_DIR=./uploads
# Dimensione massima di un file (byte, default 25 MiB).
UPLOAD_MAX_BYTES=26214400
# Lato massimo in pixel e area massima (larghezza x altezza) delle immagini.
UPLOAD_MAX_SIDE=16384
UPLOAD_MAX_PIXELS=100000000
# Upload al minuto per IP.
RATE_LIMIT_UPLOAD_MAX=30

# WebSocket (/ws). Ping ogni WS_HEARTBEAT_MS: chi non risponde entro il ping successivo viene chiuso
# (Cloudflare chiude le connessioni inattive dopo ~100 s, quindi restare sotto).
WS_HEARTBEAT_MS=30000
# Tempo massimo per il messaggio hello dopo l'apertura.
WS_HELLO_TIMEOUT_MS=10000
# Rate limit per connessione: media al secondo e raffica massima.
WS_MESSAGES_PER_SECOND=30
WS_MESSAGE_BURST=60

# Chat e tiri (M4). Voci di cronologia inviate a ogni connessione (max 500).
CHAT_HISTORY_LIMIT=50
# Rate limit per utente (su tutte le sue connessioni): media al minuto e raffica massima.
CHAT_MESSAGES_PER_MINUTE=30
CHAT_MESSAGE_BURST=10
ROLLS_PER_MINUTE=30
ROLL_BURST=10

# --- Produzione (M5) ---------------------------------------------------------------------------
# In produzione (NODE_ENV=production) il server serve anche il client compilato (packages/client/dist)
# e mette TUTTA l'API sotto /api (WebSocket: /api/ws). In sviluppo il prefisso è vuoto: il proxy di Vite
# riscrive /api/x in /x. Cambiali solo se sai cosa fai.
# API_PREFIX=/api
# Cartella del client da servire (default in produzione: packages/client/dist). SERVE_CLIENT=false = solo API.
# CLIENT_DIR=
# SERVE_CLIENT=true
# Aggiunge 'unsafe-eval' alla CSP (serve a PixiJS 8 se il client non importa pixi.js/unsafe-eval). Default: no.
# CSP_ALLOW_UNSAFE_EVAL=false
# SOLO per provare la build di produzione in locale su http://localhost (di norma BETTER_AUTH_URL deve essere https).
# ALLOW_INSECURE_HTTP=true

# Contenuti importati (docs/CONTENT.md): dimensione massima di un file/richiesta (byte, default 5 MiB)
# e tipi leggibili dai giocatori (monster e note restano sempre solo del GM).
CONTENT_MAX_BYTES=5242880
CONTENT_PLAYER_KINDS=item,spell

# Backup (npm run backup -w @lanterna/server): cartella di destinazione (relativa a packages/server) e
# numero di copie da tenere. Metti la cartella su un altro disco se puoi.
BACKUP_DIR=./backups
BACKUP_KEEP=7
