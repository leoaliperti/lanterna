{
  "name": "lanterna",
  "private": true,
  "version": "0.0.0",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run dev -w @lanterna/server\" \"npm run dev -w @lanterna/client\"",
    "build": "npm run build -w @lanterna/shared && npm run build -w @lanterna/server && npm run build -w @lanterna/client",
    "start": "npm run start -w @lanterna/server",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint . && npm run typecheck",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": ">=0.25.12"
    }
  }
}
